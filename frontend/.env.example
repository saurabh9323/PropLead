# Server-side Next.js calls use this Express API base URL.
# The browser still calls the same-origin Next API proxy under /api.
# In production on Vercel, prefer API_BASE_URL because it is server-only.
# Either the backend root URL or the /api URL works.
API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
