# PostgreSQL connection string used by Express and the setup scripts.
# Local example:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/proplead
# Supabase example:
# DATABASE_URL=postgresql://postgres.your-project-ref:your_password@aws-0-your-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Required. Use a long random value in real projects.
JWT_SECRET=replace-with-a-long-random-secret

# Optional. Express defaults to 5000 when PORT is not set.
PORT=5000

# Optional. Used only by `npm run create-admin`.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
